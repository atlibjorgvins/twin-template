# ── Storage backend ──────────────────────────────────────────────────
# Twin does NOT require a server. With everything below unset, data lives on
# the device (IndexedDB) and `npm run dev` is a working twin out of the box.
# PUBLIC_DATA_BACKEND picks explicitly: local | supabase | directus. Unset,
# the default is directus IF a PUBLIC_DIRECTUS_URL is given, local otherwise.
# The /welcome wizard lets each device override all of this at runtime.
# PUBLIC_DATA_BACKEND=
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_ANON_KEY=

# Directus base URL — OPTIONAL: only for instances backed by a Directus
# server (the personal/KLAK deployments). Leave empty for local-first.
PUBLIC_DIRECTUS_URL=

# Static token for dev (same token you use in Alfred). Leave blank once login UI ships.
PUBLIC_DIRECTUS_TOKEN=

# DIRECTUS_ADMIN_URL  the ABSOLUTE Directus URL for out-of-browser tooling —
#   the scripts in scripts/ (schema, imports, backfills) and anything else that
#   runs from a shell rather than the app. Needed because PUBLIC_DIRECTUS_URL
#   is the app-facing URL, which on a same-origin deployment is a path (/api)
#   that only resolves inside a browser. Leave unset if PUBLIC_DIRECTUS_URL is
#   already absolute (KLAK, pre-/api setups) — the scripts fall back to it.
DIRECTUS_ADMIN_URL=

# OCR service on the NAS (tailnet-only). Used by /tools/food.
PUBLIC_OCR_URL=

# ── Optional: the frettir news stack (a separate service) ────────────────
# Leave BOTH unset and the news feature does not exist in the build: no route,
# no tools tile, no coverage card on org pages, and no code shipped for it.
# The token must belong to a READ-ONLY Directus role scoped to article/source/
# mention — anything PUBLIC_* is baked into the shipped bundle.
# PUBLIC_NEWS_URL=
# PUBLIC_NEWS_TOKEN=

# ── Instance identity (multi-deployment) ─────────────────────────────
# One codebase, more than one twin. Leave all of this unset and you get the
# personal twin exactly as it always was; a second deployment gets its own
# `.env.<instance>` and `npm run build -- --mode <instance>`.
#
# PUBLIC_INSTANCE        short id, also the deploy target name (deploy/targets/<id>.conf)
# PUBLIC_INSTANCE_LABEL  what a person sees in the header — blank on the personal build
# PUBLIC_SCOPE_LOCK      pin Work/Private and hide the toggle: work | private | (blank)
# PUBLIC_DISABLED_FEATURES
#   Comma-separated modules to leave out. DENY-list: everything is on unless
#   named here, so a feature added next month lands in every instance until
#   someone decides otherwise. A name that matches nothing is reported on
#   /settings rather than silently ignored. Valid names:
#     habits food finances receipts family ai-vault games focus grants
#     photos studio campaigns evergreen brand-book prompts suggested-data
#     typing display kiosk
# PUBLIC_INSTANCE=
# PUBLIC_INSTANCE_LABEL=
# PUBLIC_SCOPE_LOCK=
# PUBLIC_DISABLED_FEATURES=

# PUBLIC_AUTH_MODE  how this build authenticates to Directus:
#   (blank)   the static token below — every visitor is the same identity.
#             What twin has always done. Default.
#   session   a real login: Directus sets an httpOnly cookie, the SDK refreshes
#             it, no token in the bundle or DOM. REQUIRES the same-origin /api
#             deployment (a cookie needs it). See docs/phase2-auth.md.
# PUBLIC_AUTH_MODE=

# PUBLIC_DATA_BACKEND  which storage adapter the repo factory uses:
#   (blank)    directus — the default, byte-identical to before this flag.
#   supabase   the Supabase adapter (docs/phase3-supabase-rls.md). Requires the
#              two vars below; a missing key falls back to Directus with a
#              console error. A runnable Supabase twin also needs the schema +
#              RLS in place — see the doc.
# PUBLIC_DATA_BACKEND=
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_ANON_KEY=
