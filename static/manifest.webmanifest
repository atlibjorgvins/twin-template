{
  "name": "2ndbrain Hub",
  "short_name": "Hub",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#2C8C99",
  "theme_color": "#2C8C99",
  "icons": [
    { "src": "/logo/mark.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Quick capture",
      "short_name": "Capture",
      "description": "Drop a thought straight into your inbox",
      "url": "/capture",
      "icons": [{ "src": "/logo/mark.svg", "sizes": "any" }]
    },
    {
      "name": "Today",
      "short_name": "Today",
      "description": "Open today's dashboard",
      "url": "/",
      "icons": [{ "src": "/logo/mark.svg", "sizes": "any" }]
    }
  ]
}
