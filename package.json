{
  "name": "twin",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "plugins:fetch": "bash scripts/fetch-plugins.sh --frozen",
    "plugins:update": "bash scripts/fetch-plugins.sh",
    "predev": "npm run plugins:fetch",
    "dev": "vite dev",
    "predev:klak": "npm run plugins:fetch",
    "dev:klak": "vite dev --mode klak",
    "prebuild": "npm run plugins:fetch",
    "build": "vite build",
    "prebuild:klak": "npm run plugins:fetch",
    "build:klak": "vite build --mode klak",
    "prebuild:desktop": "npm run plugins:fetch",
    "build:desktop": "vite build --mode desktop",
    "dmg": "tauri build --bundles app,dmg",
    "preview": "vite preview",
    "precheck": "npm run plugins:fetch",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:schedule": "node --test --experimental-strip-types src/lib/scheduleTimer/parse.test.ts",
    "test:receipt": "node --test --experimental-strip-types src/lib/receiptParser.test.ts",
    "build:ocr-worker": "esbuild extensions/directus-extension-ocr-receipts/src/index.js --bundle --platform=node --target=node18 --format=esm --outfile=extensions/directus-extension-ocr-receipts/index.js --banner:js=\"// GENERATED by npm run build:ocr-worker — edit src/index.js, not this file.\"",
    "test:events": "node --test --experimental-strip-types src/lib/events/eventTime.test.ts",
    "test:event-format": "node --test --experimental-strip-types src/lib/events/eventFormat.test.ts",
    "test:conferencing": "node --test --experimental-strip-types src/lib/events/conferencing.test.ts",
    "test:facecrop": "node --test --experimental-strip-types src/lib/studio/faceCrop.test.ts",
    "test:zip": "node --test --experimental-strip-types src/lib/studio/zip.test.ts",
    "test:food": "node --test --experimental-strip-types src/lib/food/parseFoodOrder.test.ts",
    "test:clockify": "node --test --experimental-strip-types src/lib/clockifyTime.test.ts",
    "test:clockify-tree": "node --test --experimental-strip-types src/lib/clockifyTree.test.ts",
    "test:clockify-errors": "node --test --experimental-strip-types src/lib/clockifyErrors.test.ts",
    "test:regions": "node --test --experimental-strip-types src/lib/regions.test.ts",
    "test:insights": "node --test --experimental-strip-types src/lib/insights/metrics.test.ts",
    "test:apibase": "node --test --experimental-strip-types src/lib/apiBase.test.ts",
    "test:profile": "node --test --experimental-strip-types src/lib/profileCore.test.ts",
    "test:marketing": "node --test --experimental-strip-types src/lib/marketing/metrics.test.ts",
    "test:marketing-budget": "node --test --experimental-strip-types src/lib/marketing/budget.test.ts",
    "test:marketing-export": "node --test --experimental-strip-types src/lib/marketing/export.test.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tauri-apps/cli": "^2.11.4",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.20.1",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.47",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.14",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@directus/sdk": "^18.0.0",
    "@lezer/highlight": "^1.2.3",
    "@supabase/supabase-js": "^2.112.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "codemirror": "^6.0.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "xlsx": "^0.18.5"
  }
}
