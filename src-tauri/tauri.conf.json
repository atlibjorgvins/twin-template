{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twin",
  "version": "0.1.0",
  "identifier": "is.bjorgvins.twin",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3131",
    "beforeDevCommand": "npm run dev -- --port 3131",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Twin",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
