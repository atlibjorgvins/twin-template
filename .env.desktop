# The desktop (.dmg) build — committed on purpose, unlike the per-instance
# .env files: it holds no secrets and every value below is what MAKES it the
# desktop build. `npm run dmg` uses it via `vite build --mode desktop`.

# All data lives in the app's own IndexedDB (LocalRepository). No server.
PUBLIC_DATA_BACKEND=local

# Unused in local mode, but the module graph still reads them at build time.
# localhost is a deliberate dead end: if a port leak ever dials Directus from
# the desktop app, it fails fast and visibly instead of reaching a real host.
PUBLIC_DIRECTUS_URL=http://localhost:8055
PUBLIC_DIRECTUS_TOKEN=
# Statically imported ($env/static/public) so it must EXIST; food is disabled
# below, so the empty value is never dialled.
PUBLIC_OCR_URL=

# Single-user device app: no login surface.
PUBLIC_AUTH_MODE=

# The strip build: core is People + Organizations, nothing else. ALLOW-list
# (see instance.ts): every plugin — including ones added later — is off unless
# named here. Users turn features on per device from Settings → Plugins only
# if a future build names them; `core` alone means contacts only.
PUBLIC_ENABLED_FEATURES=core
